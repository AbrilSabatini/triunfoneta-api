# ════════════════════════════════════════════════════════════════════════════
#  TRIUNFONETA — Variables de entorno
#  Copiá este archivo como .env y completá los valores
# ════════════════════════════════════════════════════════════════════════════

# ─── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/triunfoneta

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development        # development | production
FRONTEND_URL=http://localhost:3001

# ─── JWT ──────────────────────────────────────────────────────────────────────
# ⚠️  CAMBIAR en producción (mínimo 32 chars aleatorios)
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=super_secret_key_change_in_production_min_32_chars

# ─── Swagger ──────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true        # true = activo incluso en production
SWAGGER_USER=admin
SWAGGER_PASS=triunfo2025    


# ─── Rate limiting ────────────────────────────────────────────────────────────
THROTTLE_DEFAULT_LIMIT=60
THROTTLE_DEFAULT_WINDOW_MS=60000

# ─── Cola de mails ────────────────────────────────────────────────────────────
MAIL_BATCH_SIZE=10          # emails enviados en paralelo por lote
MAIL_BATCH_DELAY_MS=2000    # pausa entre lotes (ms)
MAIL_MAX_ATTEMPTS=5         # máximo de reintentos antes de EXHAUSTED

# ══════════════════════════════════════════════════════════════════════════════
#  CONFIGURACIÓN DE EMAIL — GUÍA COMPLETA
# ══════════════════════════════════════════════════════════════════════════════
#
#  La app usa Nodemailer. Estos son los valores según el proveedor SMTP:
#
#  ── OPCIÓN 1: Gmail (para DEV o equipos pequeños) 
# Video -> https://www.youtube.com/watch?v=x5soeCvnPjs
───────────────────────────
#
#  Pasos:
#  1. Entrá a tu cuenta Google → Seguridad → Verificación en dos pasos (activar)
#  2. Seguridad → Contraseñas de aplicación → Generar una nueva (ej: "Triunfoneta")
#  3. Usá esa contraseña de 16 caracteres como MAIL_PASS (sin espacios)
#
#  MAIL_HOST=smtp.gmail.com
#  MAIL_PORT=587
#  MAIL_SECURE=false          # false = STARTTLS en puerto 587
#  MAIL_USER=tucuenta@gmail.com
#  MAIL_PASS=abcd efgh ijkl mnop   # sin espacios: abcdefghijklmnop
#  MAIL_FROM_NAME=Triunfoneta
#  MAIL_FROM_ADDRESS=tucuenta@gmail.com
#
#  ⚠️  Gmail limita a ~500 emails/día para cuentas personales.
#
#  ── OPCIÓN 2: SendGrid (recomendado para producción) ────────────────────────
#
#  Pasos:
#  1. Crear cuenta en sendgrid.com (tier gratuito: 100 emails/día)
#  2. Settings → API Keys → Create API Key (Full Access o solo Mail Send)
#  3. Verificar el dominio en Sender Authentication
#
#  MAIL_HOST=smtp.sendgrid.net
#  MAIL_PORT=587
#  MAIL_SECURE=false
#  MAIL_USER=apikey          # literal "apikey", no cambiar
#  MAIL_PASS=SG.xxxxxxxxxxxx  # tu API Key de SendGrid
#  MAIL_FROM_NAME=Triunfoneta
#  MAIL_FROM_ADDRESS=noreply@triunfo.com.ar   # debe estar verificado en SendGrid
#
#  ── OPCIÓN 3: Amazon SES ────────────────────────────────────────────────────
#
#  MAIL_HOST=email-smtp.us-east-1.amazonaws.com   # ajustar región
#  MAIL_PORT=587
#  MAIL_SECURE=false
#  MAIL_USER=AKIAIOSFODNN7EXAMPLE    # SMTP credentials (≠ AWS access keys)
#  MAIL_PASS=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#  MAIL_FROM_NAME=Triunfoneta
#  MAIL_FROM_ADDRESS=noreply@triunfo.com.ar
#
#  ── OPCIÓN 4: Servidor SMTP propio / corporativo ────────────────────────────
#
#  MAIL_HOST=mail.triunfo.com.ar
#  MAIL_PORT=465
#  MAIL_SECURE=true           # true = SSL directo en puerto 465
#  MAIL_USER=noreply@triunfo.com.ar
#  MAIL_PASS=tu_contraseña_smtp
#  MAIL_FROM_NAME=Triunfoneta
#  MAIL_FROM_ADDRESS=noreply@triunfo.com.ar
#
#  ── VERIFICAR que funciona ──────────────────────────────────────────────────
#
#  Con la app corriendo:
#  curl -X POST http://localhost:3000/api/auth/login \
#    -H "Content-Type: application/json" \
#    -d '{"email":"admin@triunfo.com","password":"Triunfo2025!"}' | jq .accessToken
#
#  Luego en Swagger (http://localhost:3000/api/docs), usá el token y llamá
#  POST /admin/mail/{id}/retry con un ID de la cola para probar el reenvío.
#
# ══════════════════════════════════════════════════════════════════════════════

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tucuenta@gmail.com
MAIL_PASS=tu_app_password_sin_espacios
MAIL_FROM_NAME=Triunfoneta
MAIL_FROM_ADDRESS=tucuenta@gmail.com
